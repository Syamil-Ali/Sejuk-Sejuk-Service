NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
NEXT_PUBLIC_DEMO_MODE=true
# Shared assessment-account credential. Required only when demo mode is false.
NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=
# Server-only assistant relay. Keep disabled until Agno health and role smoke tests pass.
AGNO_ASSISTANT_URL=http://127.0.0.1:8000
AGNO_ASSISTANT_ENABLED=false
AGNO_ASSISTANT_TIMEOUT_MS=30000
