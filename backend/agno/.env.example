SEJUK_ENVIRONMENT=development
SEJUK_HOST=0.0.0.0
SEJUK_PORT=8000
SEJUK_LOG_LEVEL=INFO
SEJUK_SUPABASE_URL=https://your-project.supabase.co
SEJUK_SUPABASE_ANON_KEY=your-public-anon-key
SEJUK_SUPABASE_SERVICE_ROLE_KEY=
SEJUK_SUPABASE_JWT_AUDIENCE=authenticated
SEJUK_SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SEJUK_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SEJUK_OPENAI_API_KEY=
SEJUK_OPENAI_MODEL=gpt-5-mini
# Agno model provider. GOOGLE_API_KEY is read only by the backend.
SEJUK_MODEL_PROVIDER=gemini
SEJUK_MODEL_ID=gemini-2.5-flash
GOOGLE_API_KEY=
SEJUK_REQUEST_TIMEOUT_SECONDS=30
SEJUK_REQUESTS_PER_MINUTE=10
SEJUK_MAX_CONCURRENT_REQUESTS=2
SEJUK_CONVERSATION_RETENTION_DAYS=90
SEJUK_AUDIT_RETENTION_DAYS=365
SEJUK_QUERY_SKILL_ENABLED=false
SEJUK_QUERY_STATEMENT_TIMEOUT_MS=3000
SEJUK_QUERY_MAX_ROWS=100
SEJUK_QUERY_MAX_BYTES=65536
SEJUK_QUERY_MAX_JOINS=6
SEJUK_QUERY_MAX_NESTING=6
SEJUK_QUERY_MAX_DATE_RANGE_DAYS=366
SEJUK_SEMANTIC_PROFILE_ENABLED=true
SEJUK_SEMANTIC_PROFILE_SNAPSHOT_PATH=
SEJUK_SEMANTIC_PROFILE_PROMPT_MAX_BYTES=14000
SEJUK_SEMANTIC_PROFILE_FAIL_ON_DRIFT=true
SEJUK_SEMANTIC_PROFILE_VERIFY_DATABASE=false
SEJUK_DATA_PROFILE_ENABLED=true
SEJUK_DATA_PROFILE_CACHE_TTL_SECONDS=60
